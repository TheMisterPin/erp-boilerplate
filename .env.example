# PostgreSQL connection string (required)
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/components_playground"

# JWT signing secret for session cookies (required; minimum 32 characters in production)
JWT_SECRET="replace-with-a-long-random-string"

# Required only when creating demo users with `pnpm db:seed` (minimum 12 characters)
SEED_PASSWORD=""

# Optional overrides used by `pnpm run setup` when creating demo data.
# SEED_ADMIN_EMAIL="admin@example.com"
# SEED_ORGANIZATION_NAME="Acme Operations"

# Optional: rolling idle lifetime (default: 604800 = 7 days)
# SESSION_IDLE_MAX_AGE_SECONDS=604800

# Optional: absolute lifetime that rolling refresh cannot exceed (default: 2592000 = 30 days)
# Must be greater than or equal to SESSION_IDLE_MAX_AGE_SECONDS.
# SESSION_ABSOLUTE_MAX_AGE_SECONDS=2592000

# Optional JWT identity checks. Changing either value invalidates existing sessions.
# SESSION_JWT_ISSUER="erp-boilerplate"
# SESSION_JWT_AUDIENCE="erp-boilerplate-app"

# Optional login abuse limits (process-local default; see auth docs for production)
# LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5
# LOGIN_RATE_LIMIT_SOURCE_MAX_ATTEMPTS=25
# LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Compile-time product configuration. Restart/rebuild after changing these.
# Only NEXT_PUBLIC_* configuration is safe to import in client components.
# NEXT_PUBLIC_APP_NAME="ERP Boilerplate"
# NEXT_PUBLIC_APP_SHORT_NAME="ERP UI"
# NEXT_PUBLIC_APP_DESCRIPTION="ERP UI boilerplate"
# NEXT_PUBLIC_APP_LOGO="hexagon" # hexagon, boxes, or building
# NEXT_PUBLIC_APP_ACCENT="#5a9fd4"
# NEXT_PUBLIC_APP_ACCENT_HOVER="#72afe0"
# NEXT_PUBLIC_APP_ACCENT_MUTED="#1c3a50"
# NEXT_PUBLIC_APP_FOCUS_RING="#6bade0"
# NEXT_PUBLIC_APP_DOCUMENTATION_URL="https://github.com/TheMisterPin/erp-boilerplate#readme"
# NEXT_PUBLIC_APP_ISSUES_URL="https://github.com/TheMisterPin/erp-boilerplate/issues"
# NEXT_PUBLIC_ENABLED_MODULES="dashboard,members,activity,shiftTemplates,shifts,timeOff,departments,locations,memberships"
