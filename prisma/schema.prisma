generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                                 String            @id @default(uuid())
  email                              String            @unique
  firstName                          String
  lastName                           String
  pictureUrl                         String?
  fullName                           String
  password                           String
  role                               Role              @default(USER)
  createdAt                          DateTime          @default(now())
  updatedAt                          DateTime          @updatedAt
  deletedAt                          DateTime?
  isActive                           Boolean           @default(true)
  isVerified                         Boolean           @default(false)
  verifiedAt                         DateTime?
  verifiedBy                         String?
  departmentId                       String?
  locationId                         String?
  managedLocations                   Location[]        @relation("LocationManager")
  attendances                        ShiftAttendance[]
  shiftInstances                     ShiftInstance[]   @relation("ShiftInstanceAssignee")
  shiftTemplates                     ShiftTemplate[]   @relation("ShiftTemplateAssignee")
  reviewedTimeOffRequests            TimeOffRequest[]  @relation("TimeOffReviewer")
  timeOffRequests                    TimeOffRequest[]  @relation("TimeOffRequester")
  Department                         Department?       @relation(fields: [departmentId], references: [id])
  Location_User_locationIdToLocation Location?         @relation("User_locationIdToLocation", fields: [locationId], references: [id])
  activities                         UserActivity[]
}

model UserActivity {
  id           String   @id @default(uuid())
  userId       String
  timestamp    DateTime @default(now())
  activity     Activity
  activityData Json?
  user         User     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([timestamp])
}

model Department {
  id          String    @id @default(uuid())
  name        String
  description String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  isActive    Boolean   @default(true)
  User        User[]
}

model Location {
  id                             String            @id @default(uuid())
  name                           String
  description                    String?
  createdAt                      DateTime          @default(now())
  updatedAt                      DateTime          @updatedAt
  deletedAt                      DateTime?
  isActive                       Boolean           @default(true)
  managerId                      String?
  minimumStaff                   Int               @default(0)
  manager                        User?             @relation("LocationManager", fields: [managerId], references: [id])
  attendances                    ShiftAttendance[]
  shiftInstances                 ShiftInstance[]
  shiftTemplates                 ShiftTemplate[]
  User_User_locationIdToLocation User[]            @relation("User_locationIdToLocation")
}

model ShiftTemplate {
  id         String          @id @default(uuid())
  locationId String
  userId     String
  type       ShiftType
  startTime  String
  endTime    String
  weekdays   Int[]
  notes      String?
  isActive   Boolean         @default(true)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  deletedAt  DateTime?
  instances  ShiftInstance[]
  location   Location        @relation(fields: [locationId], references: [id])
  user       User            @relation("ShiftTemplateAssignee", fields: [userId], references: [id])

  @@index([locationId])
  @@index([userId])
}

model ShiftInstance {
  id          String            @id @default(uuid())
  templateId  String?
  locationId  String
  userId      String
  date        DateTime
  type        ShiftType
  startTime   String
  endTime     String
  status      ShiftStatus       @default(SCHEDULED)
  notes       String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
  deletedAt   DateTime?
  attendances ShiftAttendance[]
  location    Location          @relation(fields: [locationId], references: [id])
  template    ShiftTemplate?    @relation(fields: [templateId], references: [id])
  user        User              @relation("ShiftInstanceAssignee", fields: [userId], references: [id])

  @@index([templateId])
  @@index([locationId, date])
  @@index([userId, date])
}

model ShiftAttendance {
  id                 String         @id @default(uuid())
  userId             String
  shiftInstanceId    String?
  locationId         String?
  checkInAt          DateTime
  checkOutAt         DateTime?
  /// *
  ///    * Minutes on the clock; set when checking out.
  durationMinutes    Int?
  checkInActivityId  String?
  checkOutActivityId String?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  location           Location?      @relation(fields: [locationId], references: [id])
  shiftInstance      ShiftInstance? @relation(fields: [shiftInstanceId], references: [id])
  user               User           @relation(fields: [userId], references: [id])

  @@index([shiftInstanceId])
  @@index([locationId, checkInAt])
  @@index([userId, checkInAt])
}

model TimeOffRequest {
  id           String        @id @default(uuid())
  userId       String
  type         TimeOffType
  status       TimeOffStatus @default(PENDING)
  startDate    DateTime
  endDate      DateTime
  note         String?
  reviewedById String?
  reviewedAt   DateTime?
  reviewNote   String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  deletedAt    DateTime?
  reviewedBy   User?         @relation("TimeOffReviewer", fields: [reviewedById], references: [id])
  user         User          @relation("TimeOffRequester", fields: [userId], references: [id])

  @@index([status, startDate])
  @@index([userId, status])
}

enum Role {
  ADMIN
  USER
}

enum ShiftType {
  MORNING
  AFTERNOON
  NIGHT
  FULL_DAY
}

enum ShiftStatus {
  SCHEDULED
  COMPLETED
  CANCELLED
}

enum TimeOffType {
  TIME_OFF
  SICK
}

enum TimeOffStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum Activity {
  LOGIN
  LOGOUT
  REGISTER
  VERIFY
  UNVERIFY
  SHIFT_TEMPLATE_CREATE
  SHIFT_TEMPLATE_UPDATE
  SHIFT_TEMPLATE_DELETE
  SHIFT_TEMPLATE_GENERATE
  SHIFT_INSTANCE_CREATE
  SHIFT_INSTANCE_UPDATE
  SHIFT_INSTANCE_DELETE
  SHIFT_CHECK_IN
  SHIFT_CHECK_OUT
  PROFILE_UPDATE
  TIME_OFF_REQUEST
  TIME_OFF_APPROVE
  TIME_OFF_REJECT
  TIME_OFF_CANCEL
  ORGANIZATION_SWITCH
  MEMBERSHIP_ADD
  MEMBERSHIP_ACTIVATE
  MEMBERSHIP_DEACTIVATE
  MEMBERSHIP_REMOVE
  MEMBERSHIP_ROLE_CHANGE
}
